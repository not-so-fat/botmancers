# Copy this file to .env.local and fill it in.
# Read by `npm run dev`.

# Required. Hermes is the persistent runtime: your Hermes gateway key.
HERMES_API_SERVER_KEY=your-key-here

# Hermes gateway base URL (optional).
# HERMES_BASE_URL=http://127.0.0.1:8642

# Optional. A coding Agent model for Hermes gateway turns.
# HERMES_MODEL=zai/glm-4.7

# Optional. SQLite database path (default: ./botmancers.db).
# BOTMANCERS_DB_PATH=/Users/you/.botmancers/botmancers.db

# Coding-agent runs need no token here: install the provider CLIs
# (claude, codex, cursor, muse) and sign each one in.
