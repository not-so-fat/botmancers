# Server-owned Clone Market handoff. Leave unset and the import button does not navigate.
CLONE_MARKET_URL=https://example.com/clone-market

# Hermes persistent conversation (NOT-413, NOT-434)
# Unset key means ordinary turns post a visible Hermes error; no fallback transport exists.
# The gateway is an external process; these only point at it.
HERMES_API_SERVER_KEY=
# HERMES_BASE_URL=http://127.0.0.1:8642
# HERMES_TIMEOUT_MS=240000
# HERMES_SESSION_PREFIX=botmancer-specialist-
# HERMES_PROFILE_PATH=/v1/chat/completions
# HERMES_MODEL=hermes
# HERMES_WAIT_LOG_PATH=.temporal/specialist-waits.jsonl

# SQLite database file. Tests and fixtures override this per run.
# BOTMANCERS_DB_PATH=botmancers.db
# Canonical public origin of this app (snapshot parity). The app derives the
# request origin from Host / X-Forwarded-* headers, so nothing reads this yet.
# BOTMANCERS_ORIGIN=http://127.0.0.1:3333
