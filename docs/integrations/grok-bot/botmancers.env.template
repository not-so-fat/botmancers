# Botmancers app settings for the Grok Bot bridge (NOT-493).
# Add these to the environment of the app's `npm start` (it listens on 127.0.0.1:43123).
# Placeholders only. Never commit the filled-in values.

# Service authentication: <service-id>=sha256:<hex digest of the bridge's BOTMANCERS_SERVICE_TOKEN>.
#   printf %s "$BOTMANCERS_SERVICE_TOKEN" | shasum -a 256
# The service id becomes the principal recorded on every request: service:grok-bot.
BOTMANCERS_SERVICE_TOKENS=grok-bot=sha256:<SERVICE_TOKEN_SHA256_HEX>

# Coordinator allowlist: the only Agents Grok Bot may hand a task to. Comma-separated names.
BOTMANCERS_MCP_COORDINATORS=<COORDINATOR_AGENT_NAME>

# Optional: tool calls per service per rolling minute (default 60).
# BOTMANCERS_MCP_TOOL_CALLS_PER_MINUTE=60
