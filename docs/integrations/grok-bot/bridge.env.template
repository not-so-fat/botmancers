# Botmancers MCP bridge for Cursor Grok Bot (NOT-493).
# Package: botmancers@0.11.1 (exact pin; never run an unpinned `npx botmancers` here)
#
# Copy to a file outside the repository (for example ~/.config/botmancers/grok-bridge.env,
# mode 600), replace every <...> placeholder, then start the bridge with:
#
#   set -a; . ~/.config/botmancers/grok-bridge.env; set +a
#   npx --yes botmancers@0.11.1
#
# This file holds placeholders only. Never commit the filled-in copy.

# Botmancers app, on loopback on this machine. Do not point this at a public address.
BOTMANCERS_URL=http://127.0.0.1:3333

# Outbound: the bridge -> Botmancers service token. Its SHA-256 digest goes into the
# app's BOTMANCERS_SERVICE_TOKENS (see botmancers.env.template). Grok Bot never sees it.
BOTMANCERS_SERVICE_TOKEN=<SERVICE_TOKEN: openssl rand -hex 32>

# Inbound: the token Grok Bot must send as "Authorization: Bearer <token>".
# At least 16 characters and different from the service token.
BOTMANCERS_MCP_TOKEN=<MCP_TOKEN: openssl rand -hex 32>

# Keep the bridge on loopback. The HTTPS route (tunnel or reverse proxy) or the private
# network is what reaches it; it must rewrite Host to 127.0.0.1:3332.
BOTMANCERS_MCP_HOST=127.0.0.1
BOTMANCERS_MCP_PORT=3332
