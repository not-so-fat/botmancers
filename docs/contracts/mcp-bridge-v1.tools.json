              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "contract",
          "status",
          "principal",
          "coordinators"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "_meta": {
        "botmancers/contract": "botmancers.mcp.v1"
      }
    }
  ]
}
