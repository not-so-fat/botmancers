{
  "name": "botmancers",
  "version": "0.11.1",
  "description": "Botmancers: the UI, core engine, and authenticated MCP bridge (contracts botmancers.mcp.v1 and botmancers.mcp.v2) as one CLI-managed product. `botmancers start` runs it all; bare `botmancers` runs the bridge only.",
  "keywords": [
    "botmancers",
    "mcp",
    "model-context-protocol",
    "streamable-http",
    "agents",
    "ui",
    "supervisor"
  ],
  "license": "MIT",
  "author": "Yusuke Muraoka",
  "homepage": "https://github.com/not-so-fat/botmancers/tree/main/packages/mcp-server#readme",
  "bugs": {
    "url": "https://github.com/not-so-fat/botmancers/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/not-so-fat/botmancers.git",
    "directory": "packages/mcp-server"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schemas/botmancers.mcp.v1.tools.json": "./schemas/botmancers.mcp.v1.tools.json",
    "./schemas/botmancers.mcp.v2.tools.json": "./schemas/botmancers.mcp.v2.tools.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "botmancers": "dist/cli.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "schemas/*.json",
    "skills/",
    "app/",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "build:app": "node scripts/build-app.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && npm run build:app && node --test --test-timeout=120000 --test-force-exit \"test/*.test.mjs\"",
    "check:pack": "node scripts/check-pack.mjs",
    "check:skill": "node scripts/check-skill.mjs",
    "smoke:install": "node scripts/smoke-install.mjs",
    "smoke:product": "node scripts/smoke-product-install.mjs",
    "release:check": "node scripts/release.mjs",
    "prepack": "npm run build && npm run build:app"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "typescript": "5.9.3"
  }
}
